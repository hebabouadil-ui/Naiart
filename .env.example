# ─────────────────────────────────────────────────────────────
# Naiart — production environment variables
# Copy to ".env" locally, and add each in Vercel → Settings → Environment Variables.
# The site runs fully on demo data when these are absent; set them to go live.
# ─────────────────────────────────────────────────────────────

# 1) DATABASE — Postgres (Neon or Vercel Postgres). Required to persist artworks/orders.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 2) IMAGE HOSTING — Cloudinary. Required so uploaded paintings get permanent URLs.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# 3) PAYMENTS — Stripe. Required to take real payments at checkout.
STRIPE_SECRET_KEY="sk_live_or_test_xxx"

# 4) ADMIN LOGIN — credentials for the dashboard (defaults shown if unset).
ADMIN_EMAIL="admin@naiart.com"
ADMIN_PASSWORD="change-this-strong-password"

# 5) SECURITY — random string used to sign admin session cookies.
#    Generate one with:  openssl rand -base64 32
AUTH_SECRET="paste-a-long-random-string-here"

# 6) SITE URL — your live domain (used for Stripe redirects).
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
